# DataPilot 部署环境变量模板（复制为 .env 后按需修改，docker compose 自动读取）
# 平台应用（app 服务）的环境变量在 docker-compose.yml 的 app.environment 中调整

MYSQL_ROOT_PASSWORD=datapilot_root
MYSQL_PASSWORD=datapilot_pass

# Airflow
AIRFLOW_SECRET=datapilot_airflow_secret
AIRFLOW_PASSWORD=datapilot_airflow
AIRFLOW_TOKEN=

# DataX（宿主机 DataX 安装目录，含 bin/datax.py）
DATAX_HOME=./datax

# 调度引擎：local（平台内置）| airflow
SCHEDULER_ENGINE=local

# LLM（OpenAI 兼容；留空则使用内置规则引擎）
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=deepseek-chat

# 元数据定时采集间隔（小时，0=关闭）
META_COLLECT_HOURS=24
