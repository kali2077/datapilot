# DataPilot 部署环境变量模板（复制为 .env 后按需修改，docker compose 自动读取）
# 平台应用（app 服务）的环境变量在 docker-compose.yml 的 app.environment 中调整

MYSQL_ROOT_PASSWORD=datapilot_root
MYSQL_PASSWORD=datapilot_pass

# Airflow（3.x：稳定 API 在 /api/v2，认证为 JWT）
AIRFLOW_IMAGE_TAG=3.4.0
AIRFLOW_SECRET=datapilot_airflow_secret
AIRFLOW_PASSWORD=datapilot_airflow
# 平台调 Airflow 的 token 取用优先级：AIRFLOW_TOKEN 直填
# > 共享 dags 卷里 airflow 容器自动签发的 airflow_token.txt > AIRFLOW_PASSWORD(admin) 自动换 token
AIRFLOW_TOKEN=
# factory DAG 节点级回调平台时携带的平台 JWT（须 engineer 及以上角色签发：admin 登录平台
# 后从 localStorage 的 dp_token 复制）；为空时 airflow 任务无法回调。
# 注意：JWT 默认 12h 过期（JWT_EXPIRE_MINUTES=720），到期需重新签发替换；
# 生产可调大 JWT_EXPIRE_MINUTES（如 5256000=10 年）避免回调中断
DATAPILOT_TOKEN=

# DataX（宿主机 DataX 安装目录，含 bin/datax.py）
DATAX_HOME=./datax

# 调度引擎：local（平台内置）| airflow
SCHEDULER_ENGINE=local

# LLM（OpenAI 兼容；留空则使用内置规则引擎）
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=deepseek-chat

# 向量检索 RAG（可选；配置后启用语义检索，BASE_URL/key 默认复用上面的 AI_*，
# 不配置自动降级回词元匹配，行为不变）
AI_EMBED_BASE_URL=
AI_EMBED_MODEL=

# 元数据定时采集间隔（小时，0=关闭）
META_COLLECT_HOURS=24
